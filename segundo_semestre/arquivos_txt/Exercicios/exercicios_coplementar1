try:

    ips_unicos = set()

    with open('ips.txt', 'r', encoding='utf-8') as arquivo:

        for linha in arquivo:
            ip = linha.strip()

            if ip:
                ips_unicos.add(ip)

    with open('ips_unicos.txt', 'w', encoding='utf-8') as arquivo:

        for ip in ips_unicos:
            arquivo.write(f'{ip}\n')

    print('Arquivo ips_unicos.txt criado com sucesso!')

except FileNotFoundError:
    print("Erro: o arquivo 'ips.txt' não foi encontrado.")

except Exception as erro:
    print(f'Ocorreu um erro: {erro}')